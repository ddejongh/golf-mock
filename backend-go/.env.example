# Shared
VP_DATABASE_URL=postgres://venuepulse:venuepulse@localhost:5432/venuepulse?sslmode=disable
VP_REDIS_URL=redis://localhost:6379/0
VP_LOG_LEVEL=info

# Ingest (flags override these; see `go run ./cmd/ingest -h`)
VP_INGEST_GROUP=ingest
# VP_INGEST_CONSUMER defaults to hostname-pid; set only if you need a stable name.
VP_INGEST_BATCH_SIZE=500
VP_INGEST_BLOCK=2s
VP_INGEST_CLAIM_MIN_IDLE=30s
VP_INGEST_CLAIM_INTERVAL=15s
VP_INGEST_MAX_DELIVERIES=5
VP_INGEST_REFRESH_INTERVAL=10s
VP_INGEST_DLQ_STREAM=events:dlq

# Simulator (flags override these; see `go run ./cmd/simulator -h`)
VP_SIM_SCENARIO=scenarios/stadium-ingress.yaml
VP_SIM_SINK=redis
VP_SIM_STREAM_MAXLEN=100000
VP_SIM_SPEED=1
VP_SIM_SEED=0
VP_SIM_SOURCE_ID=simulator
VP_SIM_LOOP=false

# Tests
# Use an existing server (needs CREATEDB) instead of embedded Postgres:
# VP_TEST_DATABASE_URL=postgres://...
# Skip database tests entirely:
# VP_TEST_SKIP_DB=1
